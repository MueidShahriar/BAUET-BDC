{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=/api/:path*"
    },
    {
      "source": "/chat",
      "destination": "/api/index?__route=/chat"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
