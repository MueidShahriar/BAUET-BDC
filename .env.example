# Existing chatbot
GEMINI_API_KEY=

# Firebase Admin SDK (use ONE credential method)
# Option A: one-line service account JSON
FIREBASE_SERVICE_ACCOUNT=

# Option B: individual service account values
FIREBASE_PROJECT_ID=blood-donation-community-a1eb2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option C (recommended for local development): absolute path to a JSON key
# Keep this file outside public/ and outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Existing Firebase project resources
FIREBASE_DATABASE_URL=https://blood-donation-community-a1eb2-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=blood-donation-community-a1eb2.appspot.com

# Optional but recommended Firebase App Check (reCAPTCHA v3 site key is public)
FIREBASE_APP_CHECK_SITE_KEY=
FIREBASE_APP_CHECK_ENFORCED=false

# Required only when a scheduler calls POST /api/blood-requests/expire
CRON_SECRET=
