{
  "rules": {
    ".read": false,
    ".write": false,

    "events": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "recentDonations": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "stats": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "feedback": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null"
    },

    "donors": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "donorId": { 
          ".validate": "newData.isString()"
        }
      }
    },

    "admins": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "visitorTracking": {
      "presence": {
        ".read": true,
        "$sessionId": {
          ".write": "newData.val() === null || (newData.hasChildren(['updatedAt', 'path']) && newData.child('updatedAt').isNumber() && newData.child('path').isString())",
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "path": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "totalViews": {
        ".read": true,
        ".write": "newData.isNumber() && newData.val() >= 0"
      }
    }
  }
}
